ent-obj-vehicle-ridden-scooter-skateboard-hoverboard-admin = Совет директоров
    .gen = Совета директоров
    .dat = Совету директоров
    .ins = Советом директоров
    .pre = Совете директоров
    .desc = Инженерная сложность космического корабля, сконцентрированная внутри доски. И стоит столько же.

# name: holy skateboard
# desc: A board blessed by the gods with the power to grind for our sins. Has the initials 'J.C.' on the underside.
ent-obj-vehicle-ridden-scooter-skateboard-hoverboard-holyboarded = святой скейтборд
    .gen = святого скейтборда
    .dat = святому скейтборду
    .ins = святым скейтбордом
    .pre = святом скейтборде
    .desc = Доска, благословленная богами силой грайндить за наши грехи. На нижней стороне стоят инициалы «J.C.».

# name: improvised skateboard
# desc: An unfinished scooter which can only barely be called a skateboard. It's still rideable, but probably unsafe. Looks like you'll need to add a few rods to make handlebars.
ent-obj-vehicle-ridden-scooter-skateboard-improvised = самодельный скейтборд
    .gen = самодельного скейтборда
    .dat = самодельному скейтборду
    .ins = самодельным скейтбордом
    .pre = самодельном скейтборде
    .desc = Недоделанный самокат, который с трудом можно назвать скейтбордом. На нем все еще можно кататься, но, вероятно, небезопасно. Похоже, нужно добавить несколько прутьев, чтобы сделать руль.

# name: skateboard
# desc: An EightO brand professional skateboard. Looks a lot more stable than the average board.
ent-obj-vehicle-ridden-scooter-skateboard-pro = скейтборд
    .gen = скейтборда
    .dat = скейтборду
    .ins = скейтбордом
    .pre = скейтборде
    .desc = Профессиональный скейтборд марки EightO. Выглядит гораздо устойчивее обычной доски.

# name: holographic skateboard
# desc: A holographic copy of the EightO brand professional skateboard.
ent-obj-vehicle-ridden-scooter-skateboard-pro-holodeck = голографический скейтборд
    .gen = голографического скейтборда
    .dat = голографическому скейтборду
    .ins = голографическим скейтбордом
    .pre = голографическом скейтборде
    .desc = Голографическая копия профессионального скейтборда марки EightO.

# name: Wheely-Heels
# desc: Uses patented retractable wheel technology. Never sacrifice speed for style - not that this provides much of either.
ent-obj-vehicle-ridden-scooter-skateboard-wheelys = Колесные каблуки
    .gen = Колесных каблуков
    .dat = Колесным каблукам
    .acc = Колесные каблуки
    .ins = Колесными каблуками
    .pre = Колесных каблуках
    .desc = Использует запатентованную технологию убирающихся колес. Никогда не жертвуйте скоростью ради стиля, хотя это не дает ни того, ни другого.

# name: roller skates
# desc: An EightO brand pair of roller skates. Vintage, yet functional!
ent-obj-vehicle-ridden-scooter-skateboard-wheelys-rollerskates = роликовые коньки
    .gen = роликовых коньков
    .dat = роликовым конькам
    .acc = роликовых коньков
    .ins = роликовыми коньками
    .pre = роликовых коньках
    .desc = Пара роликовых коньков марки EightO. Винтажные, но рабочие!

# name: ski shoes
# desc: A pair of shoes equipped with foldable skis! Very handy to move in snowy environments unimpeded.
ent-obj-vehicle-ridden-scooter-skateboard-wheelys-skishoes = лыжные ботинки
    .gen = лыжных ботинок
    .dat = лыжным ботинкам
    .ins = лыжными ботинками
    .pre = лыжных ботинках
    .desc = Пара обуви со складными лыжами! Очень удобно для беспрепятственного передвижения по заснеженной местности.

# name: secway
# desc: A brave security cyborg gave its life to help you look like a complete tool.
ent-obj-vehicle-ridden-secway = секвей
    .gen = секвея
    .dat = секвею
    .acc = секвея
    .ins = секвеем
    .pre = секвее
    .desc = Храбрый охранный киборг отдал жизнь, чтобы помочь вам выглядеть полным придурком.

# name: Speedbike
ent-obj-vehicle-ridden-speedbike = Спидбайк
    .gen = Спидбайка
    .dat = Спидбайку
    .acc = Спидбайка
    .ins = Спидбайком
    .pre = Спидбайке

# name: wheelchair
# desc: A chair with big wheels. It looks like you can move in this on your own.
ent-obj-vehicle-ridden-wheelchair = инвалидное кресло
    .gen = инвалидного кресла
    .dat = инвалидному креслу
    .ins = инвалидным креслом
    .pre = инвалидном кресле
    .desc = Кресло с большими колесами. Похоже, в нем можно передвигаться самостоятельно.

# desc: Damn, must've been through a lot.
ent-obj-vehicle-ridden-wheelchair-gold =
    .desc = Черт, видимо, много чего повидало.

# name: motorized wheelchair
# desc: A chair with big wheels. It seems to have a motor in it.
ent-obj-vehicle-ridden-wheelchair-motorized = моторизованное инвалидное кресло
    .gen = моторизованного инвалидного кресла
    .dat = моторизованному инвалидному креслу
    .ins = моторизованным инвалидным креслом
    .pre = моторизованном инвалидном кресле
    .desc = Кресло с большими колесами. Кажется, внутри есть мотор.

# name: clown car
# desc: How someone could even fit in there is byond me.
ent-obj-vehicle-sealed-car-clowncar = клоунская машина
    .gen = клоунской машины
    .dat = клоунской машине
    .acc = клоунскую машину
    .ins = клоунской машиной
    .pre = клоунской машине
    .desc = Как кто-то вообще там помещается, мне непонятно.

# desc: Push it to the limit, walk along the razor's edge.
ent-obj-vehicle-sealed-car-speedwagon = BM Speedwagon
    .desc = Выжми все до предела, иди по лезвию бритвы.

# name: exosuit
# desc: Exosuit
ent-obj-vehicle-sealed-mecha = экзокостюм
    .gen = экзокостюма
    .dat = экзокостюму
    .ins = экзокостюмом
    .pre = экзокостюме
    .desc = Экзокостюм

# name: Clarke
# desc: Combining man and machine for a better, stronger miner. Can even resist lava! Due to its tracks it cannot strafe.
ent-obj-vehicle-sealed-mecha-clarke = Кларк
    .gen = Кларка
    .dat = Кларку
    .ins = Кларком
    .pre = Кларке
    .desc = Объединение человека и машины для лучшего, сильнейшего шахтера. Даже лавы не боится! Из-за гусениц не может двигаться боком.

# name: Durand
# desc: An aging combat exosuit utilized by the Nanotrasen corporation. Originally developed to combat hostile alien lifeforms.
ent-obj-vehicle-sealed-mecha-durand = Дюранд
    .gen = Дюранда
    .dat = Дюранду
    .ins = Дюрандом
    .pre = Дюранде
    .desc = Стареющий боевой экзокостюм, используемый корпорацией NanoTrasen. Первоначально разработан для борьбы с враждебными инопланетными формами жизни.

# name: Gygax
# desc: A lightweight, security exosuit. Popular among private and corporate security.
ent-obj-vehicle-sealed-mecha-gygax = Гигакс
    .gen = Гигакса
    .dat = Гигаксу
    .ins = Гигаксом
    .pre = Гигаксе
    .desc = Легкий охранный экзокостюм. Популярен среди частной и корпоративной охраны.

# name: Dark Gygax
# desc: A lightweight exosuit, painted in a dark scheme. This model's armor has been upgraded with a cutting-edge armor composite, resulting in greater protection and performance at the cost of modularity.
ent-obj-vehicle-sealed-mecha-gygax-dark = Темный Гигакс
    .gen = Темного Гигакса
    .dat = Темному Гигаксу
    .acc = Темный Гигакс
    .ins = Темным Гигаксом
    .pre = Темном Гигаксе
    .desc = Легкий экзокостюм, окрашенный в темную схему. Броня этой модели улучшена передовым композитом, что дает большую защиту и производительность ценой модульности.

# desc: Produced by "Tyranny of Honk, INC", this exosuit is designed as heavy clown-support. Used to spread the fun and joy of life. HONK!
ent-obj-vehicle-sealed-mecha-honker = H.O.N.K
    .desc = Произведен компанией «Tyranny of Honk, INC», этот экзокостюм предназначен для тяжелой поддержки клоунов. Используется для распространения веселья и радости жизни. ХОНК!

# desc: Produced by "Tyranny of Honk, INC", this exosuit is designed as heavy clown-support. This one has been painted black for maximum fun. HONK!
ent-obj-vehicle-sealed-mecha-honker-dark = Темный H.O.N.K
    .desc = Произведен компанией «Tyranny of Honk, INC», этот экзокостюм предназначен для тяжелой поддержки клоунов. Этот выкрашен в черный для максимального веселья. ХОНК!

# name: Marauder
# desc: Heavy-duty, combat exosuit, developed after the Durand model. Rarely found among civilian populations. Its bleeding edge armour ensures maximum usability and protection at the cost of some modularity.
ent-obj-vehicle-sealed-mecha-marauder = Мародер
    .gen = Мародера
    .dat = Мародеру
    .acc = Мародера
    .ins = Мародером
    .pre = Мародере
    .desc = Тяжелый боевой экзокостюм, разработанный после модели Дюранд. Редко встречается среди гражданского населения. Его новейшая броня обеспечивает максимальную применимость и защиту ценой некоторой модульности.

# name: Mauler
# desc: Heavy-duty, combat exosuit, developed off of the existing Marauder model, its hardened exterior prevents the use of add-on armor packages.
ent-obj-vehicle-sealed-mecha-marauder-mauler = Разрушитель
    .gen = Разрушителя
    .dat = Разрушителю
    .acc = Разрушителя
    .ins = Разрушителем
    .pre = Разрушителе
    .desc = Тяжелый боевой экзокостюм, разработанный на основе существующей модели Мародер. Его закаленная внешняя оболочка не позволяет использовать дополнительные комплекты брони.

# name: Seraph
# desc: Heavy-duty, command-type exosuit. This is a custom model, utilized only by high-ranking military personnel.
ent-obj-vehicle-sealed-mecha-marauder-seraph = Серафим
    .gen = Серафима
    .dat = Серафиму
    .acc = Серафима
    .ins = Серафимом
    .pre = Серафиме
    .desc = Тяжелый командный экзокостюм. Это индивидуальная модель, используемая только высокопоставленным военным персоналом.

# name: Odysseus
# desc: A nimble DeForest Odysseus exosuit, designed and outfitted for frontline medical support and rapid response.
ent-obj-vehicle-sealed-mecha-odysseus = Одиссей
    .gen = Одиссея
    .dat = Одиссею
    .acc = Одиссея
    .ins = Одиссеем
    .pre = Одиссее
    .desc = Проворный экзокостюм DeForest Odysseus, разработанный и оснащенный для медицинской поддержки на передовой и быстрого реагирования.

# name: Phazon
# desc: This is a Phazon exosuit. The pinnacle of scientific research and pride of Nanotrasen, it uses cutting edge anomalous technology and expensive materials.
ent-obj-vehicle-sealed-mecha-phazon = Фазон
    .gen = Фазоны
    .dat = Фазоне
    .ins = Фазоной
    .pre = Фазоне
    .desc = Это экзокостюм Фазон. Вершина научных исследований и гордость NanoTrasen, использует новейшие аномальные технологии и дорогие материалы.

# name: reticence
# desc: A silent, fast, and nigh-invisible miming exosuit. Popular among mimes and mime assassins.
ent-obj-vehicle-sealed-mecha-reticence = Сдержанность
    .gen = Сдержанности
    .dat = Сдержанности
    .ins = Сдержанностью
    .pre = Сдержанности
    .desc = Бесшумный, быстрый и почти невидимый мимский экзокостюм. Популярен среди мимов и мимов-убийц.

# desc: Autonomous Power Loader Unit MK-I. Designed primarily around heavy lifting, the Ripley can be outfitted with utility equipment to fill a number of roles.
ent-obj-vehicle-sealed-mecha-ripley = АПЛУ МК-I «Рипли»
    .desc = Автономный силовой погрузчик МК-I. Разработанный в первую очередь для подъема тяжестей, Рипли может быть оснащен вспомогательным оборудованием для выполнения множества ролей.

# desc: An ailing, old, repurposed cargo hauler. Most of its equipment wires are frayed or missing and its frame is rusted.
ent-obj-vehicle-sealed-mecha-ripley-cargo = АПЛУ «Большая Бесс»
    .desc = Больной, старый, переоборудованный грузовой тягач. Большинство проводов его оборудования истрепаны или отсутствуют, а каркас проржавел.

# name: DEATH-RIPLEY
# desc: OH SHIT IT'S THE DEATHSQUAD WE'RE ALL GONNA DIE
ent-obj-vehicle-sealed-mecha-ripley-deathripley = СМЕРТЬ-РИПЛИ
    .desc = О ЧЕРТ ЭТО ЭСКАДРОН СМЕРТИ МЫ ВСЕ УМРЕМ

# desc: OH SHIT IT'S THE DEATHSQUAD WE'RE ALL GONNA DIE. FOR REAL
ent-obj-vehicle-sealed-mecha-ripley-deathripley-real =
    .desc = О ЧЕРТ ЭТО ЭСКАДРОН СМЕРТИ МЫ ВСЕ УМРЕМ. НА ПОЛНОМ СЕРЬЕЗЕ

# desc: An old, dusty mining Ripley.
ent-obj-vehicle-sealed-mecha-ripley-mining = АПЛУ «Шахтер»
    .desc = Старый, пыльный шахтерский Рипли.

# desc: Autonomous Power Loader Unit MK-II. This prototype Ripley is refitted with a pressurized cabin, trading its prior speed for atmospheric protection and armor.
ent-obj-vehicle-sealed-mecha-ripley-mk2 = АПЛУ МК-II «Рипли»
    .desc = Автономный силовой погрузчик МК-II. Этот прототип Рипли оснащен герметичной кабиной, обменивая прежнюю скорость на атмосферную защиту и броню.

# desc: Autonomous Power Loader Unit Subtype Paddy. A Modified MK-I Ripley design intended for light security use.
ent-obj-vehicle-sealed-mecha-ripley-paddy = АПЛУ «Пэдди»
    .desc = Автономный силовой погрузчик, подтип Пэдди. Модифицированная конструкция Рипли МК-I для легкого охранного применения.

# name: Savannah-Ivanov
# desc: An insanely overbulked mecha that handily crushes single-pilot opponents. The price is that you need two pilots to use it.
ent-obj-vehicle-sealed-mecha-savannah_ivanov = Саванна-Иванов
    .gen = Саванна-Иванова
    .dat = Саванна-Иванову
    .acc = Саванна-Иванова
    .ins = Саванна-Ивановым
    .pre = Саванна-Иванове
    .desc = Безумно утяжеленный мех, который с легкостью давит одиночных пилотов-противников. Цена в том, что для управления нужны два пилота.

# name: Vim
# desc: A miniature exosuit from Nanotrasen, developed to let the irreplaceable station pets live a little longer.
ent-obj-vehicle-sealed-mecha-vim = Вим
    .desc = Миниатюрный экзокостюм от NanoTrasen, разработанный, чтобы незаменимые станционные питомцы жили чуточку дольше.

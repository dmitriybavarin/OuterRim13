item-intercom-examine-speak = Use { $token } when nearby to speak into it.

item-intercom-examine-screwed = It's <b>screwed</b> and secured to the wall.

item-intercom-examine-unscrewed = It's <i>unscrewed</i> from the wall, and can be <b>detached</b>.

item-intercom-examine-anonymize = Speaking through this intercom will anonymize your voice.

item-intercom-examine-freq-shorted = Its frequency lock has been shorted...

item-intercom-examine-freq-lock = It has a frequency lock set to { $frequency }.

item-intercom-examine-key-shorted = Its keyslot's security screws have been uplifted...

item-intercom-examine-key-stripped = The screws in its keyslot are stripped, preventing the removal of its encryption key.

item-intercom-examine-key-tight = The screws in its keyslot are fastened tight, preventing the removal of its encryption key without some kind of magnet.

item-intercom-tighten-start-others = { $user } starts tightening { $item }'s screws...

item-intercom-tighten-start-self = You start screwing in { $item }...

item-intercom-tighten-done-others = { $user } tightens { $item }'s screws!

item-intercom-tighten-done-self = You tighten { $item }'s screws.

item-intercom-loosen-start-others = { $user } starts loosening { $item }'s screws...

item-intercom-loosen-start-self = You start unscrewing { $item }...

item-intercom-loosen-done-others = { $user } loosens { $item }'s screws!

item-intercom-loosen-done-self = You unscrew { $item }, loosening it from the wall.

item-intercom-detach-unscrew-first = You need to unscrew { $item } from the wall first!

item-intercom-detach-start-others = { $user } starts unsecuring { $item }...

item-intercom-detach-start-self = You start unsecuring { $item }...

item-intercom-detach-done-others = { $user } unsecures { $item }!

item-intercom-detach-done-self = You detach { $item } from the wall.

item-intercom-emag-no-locks = no locks to break!

item-intercom-emag-broken-both = frequency and key lock broken

item-intercom-emag-broken-freq = frequency lock broken

item-intercom-emag-broken-key = key lock broken

item-intercom-emag-cant-many = can't break locks!

item-intercom-emag-cant-one = can't break lock!

item-electropack-suicide = { $user } hooks { $themself } to the electropack and spams the trigger! It looks like { $theyre } trying to commit suicide!

item-electropack-help-removing = You need help taking this off!

item-electropack-stuck = { $tool } is stuck to your hand, you cannot attach it to { $item }!

item-electropack-shock = You feel a sharp shock!

item-encryption-key-examine-empty = Has no special codes in it. You should probably tell a coder!

item-encryption-key-examine-channels = It can access the following channels; { $channels }.

item-encryption-key-examine-languages = It can translate the following languages; { $languages }.

item-headset-suicide = { $user } begins putting { $item }'s antenna up { $their } nose! It looks like { $theyre } trying to give { $themself } cancer!

item-headset-examine-screen-flash = A small screen on the headset flashes, it's too small to read without holding or wearing the headset.

item-headset-examine-screen-list = A small screen on the headset displays the following available frequencies:

item-headset-examine-volume = <b>Alt-click</b> to toggle the high-volume mode.

item-headset-examine-callouts = Use ctrl-click to enable or disable callouts.

item-headset-key-third = cannot hold a third key!

item-headset-volume-on = You toggle high-volume mode on.

item-headset-volume-off = You toggle high-volume mode off.

item-radio-examine-frequency = It is set to broadcast over the { $frequency } frequency.

item-radio-examine-modifiable = It can be attached and modified.

item-radio-examine-locked = It cannot be modified or attached.

item-radio-unscrewed = { $item } can now be attached and modified!

item-radio-screwed = { $item } can no longer be modified or attached!

item-radio-screws-stripped = The screws locking { $item }'s keyslot are stripped, and can't be removed.

item-radio-screws-tight = The screws locking { $item }'s keyslot are fastened tight, and likely can't be removed without some kind of magnet...

item-radio-keys-removed = You remove the encryption keys from { $item }.

item-radio-key-removed = You remove { $key } from { $item }.

item-radio-keys-none = { $item } doesn't have any unique encryption keys! How useless...

item-radio-key-second = cannot hold a second key!

item-radio-key-locked = keyslot is locked!

item-radio-key-cannot-install = cannot install!

item-radio-key-installed = encryption key installed

item-radio-overload = { $item } overloads.

item-radio-suicide = { $user } starts bouncing { $item } off { $their } head! It looks like { $theyre } trying to commit suicide!

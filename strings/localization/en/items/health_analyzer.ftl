item-health-analyzer-examine-use = Alt-click { $item } to toggle the limb damage readout. Ctrl-shift-click to print readout report.

item-health-analyzer-suicide = { $user } begins to analyze { $themself } with { $item }! The display shows that { $theyre } dead!

item-health-analyzer-mode-health = You switch the health analyzer to check physical health.

item-health-analyzer-mode-wound = You switch the health analyzer to report extra info on wounds.

item-health-analyzer-floor-others = { $user } analyzes { $target }'s vitals!

item-health-analyzer-floor-self = You stupidly try to analyze { $target }'s vitals!

item-health-analyzer-complex = { $target }'s biological structure is too complex for the health analyzer.

item-health-analyzer-scan-others = { $user } analyzes { $target }'s vitals.

item-health-analyzer-scan-balloon = analyzing vitals

item-health-analyzer-print-empty = no scans!

item-health-analyzer-print-busy = analyzer busy!

item-health-analyzer-print-start = printing report...

item-health-analyzer-print-done = logs cleared

item-health-analyzer-limbs-on = The scanner now shows specific limb damage.

item-health-analyzer-limbs-off = The scanner no longer shows limb damage.

item-health-analyzer-holo-many = You notice how bright holo-images appear over your various wounds. They seem to be filled with helpful information, this should make treatment easier!

item-health-analyzer-holo-one = You notice how bright holo-images appear over your wound. They seem to be filled with helpful information, this should make treatment easier!

item-health-analyzer-wounds-none = { $item } makes a happy ping and briefly displays a smiley face with several exclamation points! It's really excited to report that { $target } has no wounds!

item-health-analyzer-wounds-clear = No wounds detected in subject.

item-health-analyzer-greed = { $item } displays an eerily high-definition frowny face, chastizing you for asking it for too much encouragement.

item-health-analyzer-prick = { $item } makes a disappointed buzz and pricks your finger for being greedy. Ow!

item-health-analyzer-simple-others = { $user } scans { $target } for { $reason }.

item-health-analyzer-simple-self = You scan { $target } for { $reason }.

item-health-analyzer-simple-invalid = { $item } makes a sad buzz and briefly displays an unhappy face, indicating it can't scan { $target }.

item-health-analyzer-diseases-none = { $item } makes a happy ping and briefly displays a smiley face with several exclamation points! It's really excited to report that { $target } has no diseases!

item-medical-report-examine-bounty = This medical report is applicable for medical bounties.

item-hot-potato-explodes-others = { $item } explodes!

item-hot-potato-activates-others = { $item } activates!

item-hot-potato-timeout-self = { $item } activates! You've ran out of time!

item-hot-potato-squeeze-others = { $user } squeezes { $item }, which promptly starts to flash red-hot colors!

item-hot-potato-squeeze-self = You squeeze { $item }, activating its countdown and attachment mechanism!

item-hot-potato-squeeze-blind = You hear a mechanical click and a loud beeping!

item-hot-potato-examine-active = { $item } is flashing red-hot! You should probably get rid of it!

item-hot-potato-examine-timer = { $item }'s timer looks to be at { $time }!

item-hot-potato-equip-dread = You have a really bad feeling about { $item }!

item-hot-potato-refuse-mindless = { $item } refuses to attach to a non-sapient creature!

item-hot-potato-refuse-incapable = { $item } refuses to attach to someone incapable of using it!

item-hot-potato-force-others = { $user } forces { $item } onto { $victim }!

item-hot-potato-force-self = You force { $item } onto { $victim }!

item-hot-potato-force-blind = You hear a mechanical click and a beep.

item-hot-potato-fail-others = { $user } tried to force { $item } onto { $victim }, but it could not attach!

item-hot-potato-fail-self = You try to force { $item } onto { $victim }, but it is unable to attach!

item-hot-potato-fail-blind = You hear a mechanical click and two buzzes.

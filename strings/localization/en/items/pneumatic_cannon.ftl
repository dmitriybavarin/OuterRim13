item-pneumatic-examine-loaded = It has { $item } loaded.

item-pneumatic-examine-empty = The chamber has nothing loaded.

item-pneumatic-examine-tank = It has { $tank } mounted onto it. It could be removed with a { $tool }.

item-pneumatic-nested = You're fairly certain that putting a pneumatic cannon inside another pneumatic cannon would cause a spacetime disruption.

item-pneumatic-full = { $item } can't hold any more items!

item-pneumatic-wont-fit = { $thing } won't fit into { $item }!

item-pneumatic-too-large = { $thing } is too large to fit into { $item }!

item-pneumatic-load = You load { $thing } into { $item }.

item-pneumatic-nothing-loaded = { $item } has nothing loaded.

item-pneumatic-no-gas = { $item } can't fire without a source of gas.

item-pneumatic-pacifist = You can't bring yourself to fire { $item }! You don't want to risk harming anyone...

item-pneumatic-weak-hiss = { $item } lets out a weak hiss and doesn't react!

item-pneumatic-slip-others = { $user } loses { $their } grip on { $item }, causing it to go off!

item-pneumatic-slip-self = { $item } slips out of your hands and goes off!

item-pneumatic-fire-others = { $user } fires { $item }!

item-pneumatic-fire-self = You fire { $item }!

item-pneumatic-recoil-others = { $user } is thrown down by the force of the cannon!

item-pneumatic-recoil-self = { $item } slams into your shoulder, knocking you down!

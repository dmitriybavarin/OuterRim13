item-carrier-examine-occupant = It has { $occupant } inside.

item-carrier-examine-empty = It has nothing inside.

item-carrier-examine-usage-close = Activate it in your hand to close its door. Click-drag onto floor to release its occupants.

item-carrier-examine-usage-open = Activate it in your hand to open its door. Click-drag onto floor to release its occupants.

item-carrier-examine-alt-unlock = Alt-click to unlock its door.

item-carrier-examine-alt-lock = Alt-click to lock its door.

item-carrier-close = You close { $carrier }'s door.

item-carrier-locked = { $carrier } is locked!

item-carrier-open = You open { $carrier }'s door.

item-carrier-lock-down = You flip the lock switch down.

item-carrier-lock-up = You flip the lock switch up.

item-carrier-need-open = You need to open { $carrier }'s door!

item-carrier-too-big-catlike = You'd need a lot of catnip and treats, plus maybe a laser pointer, for that to work.

item-carrier-too-big-human = Humans, generally, do not fit into pet carriers.

item-carrier-too-big-other = You get the feeling { $target } isn't meant for a { $name }.

item-carrier-self = Why would you ever do that?

item-carrier-climb-out-others = { $user } climbs out of { $carrier }!

item-carrier-climb-out-self = { $user } jumps out of { $carrier }!

item-carrier-push-open-others = { $user } pushes open the door to { $carrier }!

item-carrier-push-open-self = { $user } pushes open the door of { $carrier }!

item-carrier-poke-self = You poke a limb through { $carrier }'s bars and start fumbling for the lock switch... (This will take some time.)

item-carrier-poke-others = You see { $user } reach through the bars and fumble for the lock switch!

item-carrier-flip-others = { $user } flips the lock switch on { $carrier } by reaching through!

item-carrier-flip-self = Bingo! The lock pops open!

item-carrier-rattle-others = { $carrier } starts rattling as something pushes against the door!

item-carrier-rattle-self = You start pushing out of { $carrier }... (This will take about 20 seconds.)

item-carrier-shove-others = { $user } shoves out of { $carrier }!

item-carrier-shove-self = You shove open { $carrier }'s door against the lock's resistance and fall out!

item-carrier-unload-others = { $user } unloads { $carrier }.

item-carrier-unload-self = You unload { $carrier } onto { $target }.

item-carrier-full = { $carrier } is already carrying too much!

item-carrier-load-start-others = { $user } starts loading { $target } into { $carrier }.

item-carrier-load-start-self = You start loading { $target } into { $carrier }...

item-carrier-load-start-target = { $user } starts loading you into { $their } { $name }!

item-carrier-load-done-others = { $user } loads { $target } into { $carrier }!

item-carrier-load-done-self = You load { $target } into { $carrier }.

item-carrier-load-done-target = { $user } loads you into { $their } { $name }!

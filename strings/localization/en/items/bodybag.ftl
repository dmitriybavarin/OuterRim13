item-bodybag-suicide = { $user } is crawling into { $item }! It looks like { $theyre } trying to commit suicide!

item-bodybag-examine-shapes = You can make out the { $count ->
    [one] shape
   *[other] shapes
 } of { $count } { $count ->
    [one] object
   *[other] objects
 } through the fabric.

item-bodybag-destroy_free = You suddenly feel the space around you torn apart! You're free!

item-bodybag-deploy_free = You suddenly feel air around you! You're free!

item-bodybag-resist-restrained = You can't get out while you're restrained like this!

item-bodybag-resist-claw = You claw at the fabric of { $item }, trying to tear it open...

item-bodybag-resist-notice = Someone starts trying to break free of { $item }!

item-bodybag-resist-stop = The pressure subsides. It seems that they've stopped resisting...

item-bodybag-escape-others = { $user } suddenly appears in front of { $holder }!

item-bodybag-escape-user = { $user } breaks free of { $item }!

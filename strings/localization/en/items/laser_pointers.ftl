item-laserpointer-diode-removed = removed diode

item-laserpointer-lens-removed = removed crystal lens

item-laserpointer-diode-present = already has a diode!

item-laserpointer-diode-jam-blocked = You try to jam { $item } in place, but { $lens } is in the way!

item-laserpointer-diode-jam-user = You jam { $item } in too hard and break { $lens } inside, teleporting you away!

item-laserpointer-diode-jam-item = You jam { $item } in too hard and break { $lens } inside, teleporting { $item } away!

item-laserpointer-diode-installed = installed { $item }

item-laserpointer-lens-present = already has a lens!

item-laserpointer-lens-jam-blocked = You try to jam { $item } in front of the diode, but it's a bad fit!

item-laserpointer-lens-press-user = You press on { $item } too hard and are teleported away!

item-laserpointer-lens-press-pointer = You press on { $item } too hard and { $pointer } is teleported away!

item-laserpointer-lens-installed = installed { $item }

item-laserpointer-lens-install-info = You install a { $item } in { $pointer }. It can now be used to shine through obstacles at the cost of double the energy drain.

item-laserpointer-examine-no-diode = The diode is missing.

item-laserpointer-examine-diode = A class <b>{ $rating }</b> laser diode is installed. It is <i>screwed</i> in place.

item-laserpointer-examine-charge = A small display reads out that there is <b>{ $percent }%</b> total charge remaining.

item-laserpointer-examine-charge-locked = A small display reads out that it is currently recharging to full, and there is <b>{ $percent }%</b> total charge remaining.

item-laserpointer-examine-lens = There is a <b>{ $item }</b> fit neatly before the focus lens. It can be <i>plucked out</i> with some <i>wirecutters</i>.

item-laserpointer-examine-hint = <i>You could examine it more thoroughly...</i>

item-laserpointer-examine-more-1 = <i>{ $item } is fit neatly into the casing.</i>

item-laserpointer-examine-more-2 = <i>{ $item } is secured in place, with a little bit of room left between it and the focus lens.</i>

item-laserpointer-examine-more-3 = <i>{ $item }'s size is much smaller compared to the previous generation lasers, and the wide margin between it and the focus lens could probably house <b>a crystal</b> of some sort.</i>

item-laserpointer-no-diode = You point { $item } at { $target }, but nothing happens!

item-laserpointer-no-dexterity = You don't have the dexterity to do this!

item-laserpointer-chunky-fingers = Your fingers can't press the button!

item-laserpointer-too-far = { $target } is too far away!

item-laserpointer-through-walls = You can't point with { $item } through walls!

item-laserpointer-cant-make-out = You can't quite make out your target and you fail to shine at it.

item-laserpointer-charging = You point { $item } at { $target }, but it's still charging.

item-laserpointer-target-dead = You point { $item } at { $target }, but { $they } appear{ $s } to be dead!

item-laserpointer-blind-success = You blind { $target } by shining { $item } in { $their } eyes.

item-laserpointer-blind-fail = You fail to blind { $target } by shining { $item } at { $their } eyes!

item-laserpointer-silicon-dead = You point { $item } at { $target }, but { $they } appear{ $s } to be non-functioning.

item-laserpointer-silicon-overloaded = Your sensors were overloaded by a laser!

item-laserpointer-overload-success = You overload { $target } by shining { $item } at { $their } sensors.

item-laserpointer-overload-fail = You fail to overload { $target } by shining { $item } at { $their } sensors!

item-laserpointer-camera-disabled = You point { $item } at { $target }, but it seems to be disabled.

item-laserpointer-camera-hit = You hit the lens of { $target } with { $item }, temporarily disabling the camera!

item-laserpointer-camera-miss = You miss the lens of { $target } with { $item }!

item-laserpointer-cat-grab-others = { $target } makes a grab for the light!

item-laserpointer-cat-grab-self = LIGHT!

item-laserpointer-cat-distracted-others = { $target } looks briefly distracted by the light.

item-laserpointer-cat-distracted-self = You're briefly tempted by the shiny light...

item-laserpointer-cat-stare-others = { $target } stares at the light.

item-laserpointer-cat-stare-self = You stare at the light...

item-laserpointer-point = You point { $item } at { $target }.

item-laserpointer-overused = { $item }'s battery is overused, it needs time to recharge!

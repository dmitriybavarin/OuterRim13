item-extinguisher-safety-off = safety off

item-extinguisher-examine-safety-on = The safety is on.

item-extinguisher-examine-safety-off = The safety is off.

item-extinguisher-examine-empty = Alt-click to empty it.

item-extinguisher-full = already full!

item-extinguisher-bad-liquid = can't refill with this liquid!

item-extinguisher-refilled = { $item } has been refilled by { $amount } units.

item-extinguisher-source-empty = { $source } is empty!

item-extinguisher-empty = it's empty!

item-extinguisher-hold-required = You must be holding { $item } in your hands to do this!

item-extinguisher-dump-others = { $user } empties out { $item } onto the floor using the release valve.

item-extinguisher-dump-self = You quietly empty out { $item } using its release valve.


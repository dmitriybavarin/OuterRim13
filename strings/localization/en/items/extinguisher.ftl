item-extinguisher-bash-raise-self = { $user } begins to raise { $item }, aiming to cave in your { $head }!

item-extinguisher-bash-down-others = { $user } brings { $item } heavily down on { $target }'s { $head }.

item-extinguisher-bash-down-self = { $user } brings { $item } heavily down on your { $head }!


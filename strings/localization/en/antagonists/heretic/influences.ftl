heretic-influence-psychic-beheaded = Psychic tendrils lash out from { $influence }, psychically grabbing onto { $user }'s psychically sensitive mind and tearing { $gender ->
    [male] his
    [female] her
    [plural] their
   *[neuter] its
 } head off!

heretic-influence-examine-burn = Your mind burns as you stare at the tear!

heretic-influence-already-draining = already being drained!

heretic-influence-draining = draining influence...

heretic-influence-interrupted = interrupted!

heretic-influence-drained = influence drained

heretic-influence-fading = { $influence } begins to fade into reality!

heretic-starting-ritual-cant-awaken = ritual failed, { $slot } can't be awakened!

heretic-starting-heart-awakened = You feel your { $organ } begin pulse faster and faster as it awakens!

heretic-starting-owls-tearing = You feel something invisible tearing away at your very essence!

heretic-starting-owls-ravaged = Your ambition is ravaged, but something powerful remains in its wake...

heretic-organ-slot-heart = heart

heretic-organ-slot-lungs = lungs

heretic-organ-slot-liver = liver

heretic-organ-slot-stomach = stomach
